<subviews><scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" showsHorizontalScrollIndicator="NO" translatesAutoresizingMaskIntoConstraints="NO" id="home-scroll">
<rect key="frame" x="0" y="62" width="393" height="707"/>
<subviews><stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="home-stack" userLabel="Contenu assemblé dans ViewController.swift">
<rect key="frame" x="24" y="16" width="345" height="675"/></stackView></subviews>
<constraints>
<constraint firstItem="home-stack" firstAttribute="top" secondItem="home-content-guide" secondAttribute="top" constant="16" id="home-top"/>
<constraint firstItem="home-content-guide" firstAttribute="bottom" secondItem="home-stack" secondAttribute="bottom" constant="32" id="home-bottom"/>
