                    <tabBarItem key="tabBarItem" title="Le mur" id="wall-tab-item"/>
                    <connections>
                        <outlet property="contentStack" destination="wall-stack" id="wall-stack-outlet"/>
                        <outlet property="scrollView" destination="wall-scroll" id="wall-scroll-outlet"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="wall-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="900" y="-500"/>
        </scene>
        <!--Groupes-->
        <scene sceneID="groups-scene">
            <objects>
