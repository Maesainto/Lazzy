                        <color key="backgroundColor" red="0.96860000000000002" green="0.96079999999999999" blue="0.93730000000000002" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="wall-scroll" firstAttribute="bottom" secondItem="wall-safe" secondAttribute="bottom" id="wall-scroll-bottom"/>
                            <constraint firstItem="wall-scroll" firstAttribute="leading" secondItem="wall-view" secondAttribute="leading" id="wall-scroll-leading"/>
                            <constraint firstItem="wall-scroll" firstAttribute="top" secondItem="wall-safe" secondAttribute="top" id="wall-scroll-top"/>
                            <constraint firstItem="wall-scroll" firstAttribute="trailing" secondItem="wall-view" secondAttribute="trailing" id="wall-scroll-trailing"/>
                        </constraints>
