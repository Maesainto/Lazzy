<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25408" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="lazzy-tabs">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25407"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Lazzy Tab Bar Controller-->
        <scene sceneID="tab-scene">
            <objects>
                <tabBarController id="lazzy-tabs" customClass="LazzyTabBarController" customModule="Lazzy" customModuleProvider="target" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="lazzy-tabbar">
                        <rect key="frame" x="0.0" y="803" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    </tabBar>
                    <connections>
                        <segue destination="home-controller" kind="relationship" relationship="viewControllers" id="tab-home"/>
                        <segue destination="wall-controller" kind="relationship" relationship="viewControllers" id="tab-wall"/>
                        <segue destination="groups-controller" kind="relationship" relationship="viewControllers" id="tab-groups"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="tab-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
        <!--Accueil-->
        <scene sceneID="home-scene">
            <objects>
                <viewController storyboardIdentifier="home" id="home-controller" customClass="ViewController" customModule="Lazzy" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="home-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" ambiguous="YES" showsHorizontalScrollIndicator="NO" translatesAutoresizingMaskIntoConstraints="NO" id="home-scroll">
                                <rect key="frame" x="0.0" y="62" width="393" height="707"/>
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" ambiguous="YES" axis="vertical" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="home-stack" userLabel="Contenu assemblé dans ViewController.swift">
                                        <rect key="frame" x="24" y="16" width="345" height="675"/>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="home-stack" firstAttribute="width" relation="lessThanOrEqual" secondItem="home-frame-guide" secondAttribute="width" constant="-48" id="home-available-width"/>
                                    <constraint firstItem="home-content-guide" firstAttribute="bottom" secondItem="home-stack" secondAttribute="bottom" constant="32" id="home-bottom"/>
                                    <constraint firstItem="home-stack" firstAttribute="centerX" secondItem="home-frame-guide" secondAttribute="centerX" id="home-center"/>
                                    <constraint firstItem="home-content-guide" firstAttribute="width" secondItem="home-frame-guide" secondAttribute="width" id="home-content-width"/>
                                    <constraint firstItem="home-stack" firstAttribute="width" relation="lessThanOrEqual" constant="560" id="home-max-width"/>
                                    <constraint firstItem="home-stack" firstAttribute="top" secondItem="home-content-guide" secondAttribute="top" constant="16" id="home-top"/>
                                    <constraint firstItem="home-stack" firstAttribute="width" secondItem="home-frame-guide" secondAttribute="width" priority="750" constant="-48" id="home-width"/>
                                </constraints>
                                <viewLayoutGuide key="contentLayoutGuide" id="home-content-guide"/>
                                <viewLayoutGuide key="frameLayoutGuide" id="home-frame-guide"/>
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="home-safe"/>
                        <color key="backgroundColor" red="0.96860000000000002" green="0.96079999999999999" blue="0.93730000000000002" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="home-scroll" firstAttribute="bottom" secondItem="home-safe" secondAttribute="bottom" id="home-scroll-bottom"/>
                            <constraint firstItem="home-scroll" firstAttribute="leading" secondItem="home-view" secondAttribute="leading" id="home-scroll-leading"/>
                            <constraint firstItem="home-scroll" firstAttribute="top" secondItem="home-safe" secondAttribute="top" id="home-scroll-top"/>
                            <constraint firstItem="home-scroll" firstAttribute="trailing" secondItem="home-view" secondAttribute="trailing" id="home-scroll-trailing"/>
                        </constraints>
                    </view>
                    <tabBarItem key="tabBarItem" title="Accueil" id="home-tab-item"/>
                    <connections>
                        <outlet property="contentStack" destination="home-stack" id="home-stack-outlet"/>
                        <outlet property="scrollView" destination="home-scroll" id="home-scroll-outlet"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="home-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1810" y="-193"/>
        </scene>
        <!--Le mur-->
        <scene sceneID="wall-scene">
            <objects>
                <viewController storyboardIdentifier="wall" id="wall-controller" customClass="WallViewController" customModule="Lazzy" customModuleProvider="target" sceneMemberID="viewController">
