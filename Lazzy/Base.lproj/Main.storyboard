<constraint firstItem="home-content-guide" firstAttribute="width" secondItem="home-frame-guide" secondAttribute="width" id="home-content-width"/>
</constraints>
<viewLayoutGuide key="contentLayoutGuide" id="home-content-guide"/><viewLayoutGuide key="frameLayoutGuide" id="home-frame-guide"/>
</scrollView></subviews>
<viewLayoutGuide key="safeArea" id="home-safe"/>
<color key="backgroundColor" red="0.9686" green="0.9608" blue="0.9373" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
<constraints>
